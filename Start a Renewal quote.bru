meta {
  name: Start a Renewal quote
  type: http
  seq: 6
}

put {
  url: https://api-{{environment}}.instanda-eu.com/Live/v0.1/Package{{packageId}}/StartRenewal?siteDomainName={{siteDomain}}&salesPersonUserName={{salesPersonUserName}}&policyNumber={{policyNumber}}&policyStartDate=2026-11-29
  body: json
  auth: basic
}

params:query {
  siteDomainName: {{siteDomain}}
  salesPersonUserName: {{salesPersonUserName}}
  policyNumber: {{policyNumber}}
  policyStartDate: 2026-11-29
}

headers {
  accept: application/json
